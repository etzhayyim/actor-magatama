#!/usr/bin/env bb
;; magatama — bb-native test runner (Clojure / babashka; no shell). ADR-2606072802.
;; Per the repo-wide rule (root CLAUDE.md §"Operational code = clj/bb"): first-party
;; tooling is clj/bb, NOT shell. New actors ship run_tests.cljk, not run_tests.sh.
;;
;;   bb test      ; run from the standalone repository root
;;
;; Runs the bb/cljc cell tests (shionome_core + every shionome/suimin cell run-chain +
;; Council gate), per the repo py→cljc rule.
(require '[babashka.classpath :as cp]
         '[babashka.fs :as fs])

(cp/add-classpath (str (fs/path (fs/parent (fs/absolutize *file*)) "src")))
(cp/add-classpath (str (fs/path (fs/parent (fs/absolutize *file*)) "test")))

(require '[clojure.test :as t]
         'magatama.cells.test-cells
         'magatama.repository-contract-test)

(println "=== magatama cljc cell tests ===")
(let [r (t/run-tests 'magatama.cells.test-cells 'magatama.repository-contract-test)]
  (System/exit (if (zero? (+ (:fail r) (:error r))) 0 1)))
